.{
    .{
        .ecosystem = "python",
        .forbidden_calls = .{ "eval", "exec", "compile", "globals", "locals", "__import__", "setattr", "getattr" },
        .constant_constructors = .{ "dict", "list", "set", "tuple", "frozenset" },
        .total_conversions = .{ "str", "repr", "format", "ascii" },
        .length_calls = .{"len"},
        .type_checks = .{"isinstance"},
        .null_types = .{"None"},
        .test_prefixes = .{"test"},
        .test_file_prefixes = .{"test_"},
        .test_file_suffixes = .{"_test.py"},
        .sleeps = .{ "time.sleep", "sleep" },
        .nondeterministic = .{ "random.random", "random.randint", "random.choice", "random.choices", "random.shuffle", "random.sample", "random.uniform", "random.gauss", "time.time", "time.monotonic", "time.perf_counter", "time.process_time", "time.time_ns", "time.time.time", "time.time.monotonic", "time.time.perf_counter", "time.time.process_time", "time.time.time_ns", "datetime.now", "datetime.today", "datetime.utcnow", "datetime.datetime.now", "datetime.datetime.today", "datetime.datetime.utcnow", "uuid.uuid1", "uuid.uuid4", "os.urandom", "np.random.rand", "np.random.randn", "np.random.randint", "np.random.random", "np.random.choice", "np.random.shuffle", "np.random.sample", "np.random.uniform", "np.random.normal", "np.random.permutation", "numpy.random.rand", "numpy.random.randn", "numpy.random.randint", "numpy.random.random", "numpy.random.choice", "numpy.random.shuffle", "numpy.random.sample", "numpy.random.uniform", "numpy.random.normal", "numpy.random.permutation" },
        .self_receivers = .{ "self", "cls" },
        .methods_need_receiver = true,
        .mutating_calls = .{ "pop", "popitem", "append", "extend", "insert", "remove", "clear", "update", "add", "discard", "setdefault", "next", "send", "write", "sort", "reverse" },
        .test_doubles = .{ "Mock", "MagicMock", "AsyncMock", "PropertyMock", "NonCallableMock", "NonCallableMagicMock" },
    },
    .{
        .ecosystem = "zig",
        .allocating_calls = .{ "alloc", "create", "dupe", "dupeZ", "realloc", "alignedAlloc", "allocSentinel", "allocPrint", "allocPrintSentinel", "append", "appendSlice", "appendNTimes", "insert", "insertSlice", "addOne", "addManyAsSlice", "ensureTotalCapacity", "ensureUnusedCapacity", "ensureTotalCapacityPrecise", "initCapacity", "put", "putNoClobber", "getOrPut", "getOrPutValue", "toOwnedSlice", "readFileAlloc", "readToEndAlloc", "join", "concat", "allocLowerString", "allocUpperString" },
        .initializer_prefixes = .{ "init", "main", "build" },
        .test_file_suffixes = .{"_test.zig"},
        .self_receivers = .{"self"},
        .mutating_calls = .{ "pop", "append", "appendSlice", "appendAssumeCapacity", "insert", "orderedRemove", "swapRemove", "put", "putNoClobber", "getOrPut", "remove", "fetchRemove", "next", "clearRetainingCapacity", "clearAndFree", "resize", "shrinkRetainingCapacity", "write", "writeAll", "print", "reset" },
        .sleeps = .{ "std.Thread.sleep", "std.time.sleep" },
        .nondeterministic = .{ "std.crypto.random.int", "std.crypto.random.intRangeAtMost", "std.crypto.random.intRangeLessThan", "std.crypto.random.float", "std.crypto.random.boolean", "std.crypto.random.bytes", "std.time.timestamp", "std.time.milliTimestamp", "std.time.microTimestamp", "std.time.nanoTimestamp" },
    },
    .{
        .ecosystem = "go",
        .test_prefixes = .{"Test"},
        .methods_need_receiver = true,
        .sleeps = .{"time.Sleep"},
        .nondeterministic = .{ "rand.Int", "rand.Intn", "rand.Int63", "rand.Float64", "rand.Perm", "rand.Shuffle", "time.Now", "uuid.New", "uuid.NewString" },
        .test_doubles = .{"gomock.NewController"},
        .mutating_calls = .{ "Add", "Delete", "Push", "Pop", "Store", "Swap", "Write", "WriteString", "Next" },
    },
    .{
        .ecosystem = "node",
        .forbidden_calls = .{"eval"},
        .self_receivers = .{"this"},
        .methods_need_receiver = true,
        .sleeps = .{ "setTimeout", "sleep", "page.waitForTimeout" },
        .nondeterministic = .{ "Math.random", "Date.now", "crypto.randomUUID", "crypto.getRandomValues", "performance.now" },
        .test_doubles = .{ "jest.fn", "jest.spyOn", "jest.mock", "vi.fn", "vi.spyOn", "vi.mock", "sinon.stub", "sinon.spy", "sinon.mock" },
        .mutating_calls = .{ "push", "pop", "shift", "unshift", "splice", "set", "delete", "add", "clear", "next", "sort", "reverse" },
        .null_types = .{"null"},
    },
    .{
        .ecosystem = "rust",
        .allocating_calls = .{ "Box::new", "Rc::new", "Arc::new", "Vec::with_capacity", "String::from", "String::with_capacity", "to_string", "to_owned", "to_vec", "clone", "collect", "push", "push_str", "insert", "extend", "reserve" },
        .initializer_prefixes = .{ "new", "init", "main", "default" },
        .self_receivers = .{"self"},
        .methods_need_receiver = true,
        .sleeps = .{ "std::thread::sleep", "thread::sleep", "tokio::time::sleep", "sleep" },
        .nondeterministic = .{ "rand::random", "rand::thread_rng", "thread_rng", "SystemTime::now", "Instant::now", "Uuid::new_v4" },
        .mutating_calls = .{ "push", "pop", "insert", "remove", "clear", "next", "take", "swap", "drain", "truncate" },
    },
    .{
        .ecosystem = "jvm",
        .self_receivers = .{"this"},
        .sleeps = .{ "Thread.sleep", "TimeUnit.SECONDS.sleep", "TimeUnit.MILLISECONDS.sleep" },
        .nondeterministic = .{ "Math.random", "System.currentTimeMillis", "System.nanoTime", "UUID.randomUUID", "LocalDateTime.now", "LocalDate.now", "Instant.now" },
        .test_doubles = .{ "mock", "Mockito.mock", "spy", "Mockito.spy" },
        .mutating_calls = .{ "add", "remove", "put", "clear", "poll", "pop", "push", "next", "set", "offer" },
        .null_types = .{"null"},
    },
}
