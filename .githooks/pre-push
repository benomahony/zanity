#!/bin/sh
set -eu

root=$(git rev-parse --show-toplevel)
cd "$root"

head=$(git rev-parse HEAD)
while read -r local_ref local_sha remote_ref remote_sha; do
    case "$local_ref" in
        refs/heads/*)
            if [ "$local_sha" != "$head" ]; then
                echo "pre-push: $local_ref is not checked out; check out and validate it before pushing" >&2
                exit 1
            fi
            ;;
    esac
done

if ! git diff --quiet --ignore-submodules -- || ! git diff --cached --quiet --ignore-submodules --; then
    echo "pre-push: tracked files differ from HEAD; commit or restore them so the hook tests exactly what will be pushed" >&2
    exit 1
fi

echo "pre-push: running the full CI gate" >&2
zig build test --summary all
zig build release
case "$(uname -s)-$(uname -m)" in
    Linux-x86_64) zanity=zig-out/release/zanity-linux-x86_64 ;;
    Linux-aarch64 | Linux-arm64) zanity=zig-out/release/zanity-linux-aarch64 ;;
    Darwin-x86_64) zanity=zig-out/release/zanity-macos-x86_64 ;;
    Darwin-arm64) zanity=zig-out/release/zanity-macos-aarch64 ;;
    *)
        echo "pre-push: no release binary runs on $(uname -s)-$(uname -m); run zig build test-integration instead" >&2
        exit 1
        ;;
esac
zig build test-integration -Dzanity="$zanity" --summary all
"$zanity" check . --fail-on warning
uv run --with 'PyYAML==6.0.3' python catalogue/sync.py
python3 catalogue/triage.py
git diff --exit-code -- catalogue
python3 -m unittest bench.parity.test_page bench.parity.test_ratchet
python3 bench/parity/ratchet.py
python3 bench/parity/page.py
git diff --exit-code -- docs/content/comparison*.smd
./scripts/zig-cache --check
