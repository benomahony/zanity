#!/bin/sh
set -eu

llama=b12506
revision=6ea3e3a309d12a4779cfda98b8c19800d2d5da71
model=embeddinggemma-2-Q8_0.gguf
cache=${ZANITY_SEMANTIC_CACHE:-$HOME/.cache/zanity-semantic}
port=${ZANITY_SEMANTIC_PORT:-8080}
mkdir -p "$cache"

server="$cache/llama-server-$llama"
if [ ! -x "$server" ]; then
  echo "semantic-server: building llama-server $llama, once per cache" >&2
  src=$(mktemp -d)
  git -c advice.detachedHead=false clone -q --depth 1 --branch "$llama" https://github.com/ggml-org/llama.cpp "$src"
  cmake -S "$src" -B "$src/build" -DCMAKE_BUILD_TYPE=Release -DLLAMA_CURL=OFF -DGGML_NATIVE=OFF -DBUILD_SHARED_LIBS=OFF -DLLAMA_BUILD_TESTS=OFF -DLLAMA_BUILD_EXAMPLES=OFF >/dev/null
  cmake --build "$src/build" --target llama-server -j "$(getconf _NPROCESSORS_ONLN)" >/dev/null
  cp "$src/build/bin/llama-server" "$server"
  rm -rf "$src"
fi

weights="$cache/$revision-$model"
if [ ! -s "$weights" ]; then
  echo "semantic-server: downloading $model, once per cache" >&2
  curl -fsSL -o "$weights.part" "https://huggingface.co/ggml-org/embeddinggemma-2-GGUF/resolve/$revision/$model"
  mv "$weights.part" "$weights"
fi

"$server" -m "$weights" --embedding -c 8192 -ub 2048 -b 2048 --port "$port" >"$cache/server.log" 2>&1 &
pid=$!
for _ in $(seq 300); do
  if curl -fs "http://127.0.0.1:$port/health" >/dev/null 2>&1; then
    echo "semantic-server: EmbeddingGemma 2 is serving http://127.0.0.1:$port/v1/embeddings" >&2
    exit 0
  fi
  kill -0 "$pid" 2>/dev/null || break
  sleep 1
done
echo "semantic-server: llama-server did not start on port $port; its log:" >&2
cat "$cache/server.log" >&2
exit 1
