package scope

func narrow(flag bool) int {
	if flag {
		onlyInside := 3
		return onlyInside + 1
	}
	return 0
}

func declared(flag bool) int {
	if flag {
		var total int
		total = 2
		return total
	}
	return 0
}

func received(flag bool, ch chan int) int {
	value := <-ch
	if flag {
		return value
	}
	return 0
}
